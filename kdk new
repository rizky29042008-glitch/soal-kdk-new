<script>
const BANK = [{"id":"Q001","domain":"H","kind":"case","tier":1,"question":"Seorang klien dengan penyakit kronis mengeluh nyeri, sulit tidur, dan menolak tindakan karena takut. Perawat hanya berfokus pada angka tanda vital dan meminta klien mengikuti jadwal tindakan. Aspek yang paling jelas belum digali adalah ...","options":["Respons psikologis, makna spiritual, dan alasan personal klien","Hanya riwayat penyakit keluarga karena faktor lain sudah terwakili","Kepatuhan klien terhadap seluruh instruksi medis","Kebutuhan administrasi sebelum tindakan"],"answer":0,"explanation":"Keperawatan holistik tidak berhenti pada data fisik. Rasa takut, pengalaman subjektif, makna spiritual, dan alasan penolakan perlu digali serta divalidasi bersama klien.","source":"Holistik, hlm. 17–21","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q002","domain":"I","kind":"case","tier":1,"question":"Perawat menerima instruksi insulin melalui telepon. Apoteker menemukan dosis pada resep berbeda dari instruksi yang disampaikan. Tindakan tim yang paling aman sebelum obat diberikan adalah ...","options":["Menunda klarifikasi dan mengikuti instruksi yang terakhir diterima","Mencatat instruksi, membaca kembali, lalu meminta konfirmasi pemberi instruksi","Meminta keluarga memilih dosis yang dianggap paling aman","Mengikuti dosis pada resep tanpa menyampaikan perbedaan"],"answer":1,"explanation":"Ketidaksesuaian instruksi harus diklarifikasi. TBaK dilakukan dengan menulis instruksi, membacakan kembali, dan memperoleh konfirmasi pemberi instruksi.","source":"IPC, slide 13; slide 16","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q003","domain":"P","kind":"standard","tier":1,"question":"Seorang perawat mulai mengumpulkan keluhan, riwayat kesehatan, hasil observasi, pemeriksaan fisik, dan data penunjang sebelum merumuskan masalah klien. Kegiatan tersebut termasuk standar ...","options":["Perencanaan","Evaluasi","Pengkajian","Implementasi"],"answer":2,"explanation":"Pengkajian merupakan pengumpulan data secara sistematis, menyeluruh, akurat, singkat, dan berkesinambungan untuk membentuk data dasar klien.","source":"Standar Praktik, hlm. 8–10","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q004","domain":"S","kind":"app","tier":1,"question":"Puskesmas merujuk pasien ke rumah sakit dengan layanan spesialis karena kebutuhan pasien tidak dapat ditangani pada tingkat pertama. Jenis rujukan berdasarkan arah tingkat pelayanannya adalah ...","options":["Rujukan horizontal","Rujukan vertikal","Rujukan kesehatan","Rujukan internal"],"answer":1,"explanation":"Rujukan vertikal merupakan pelimpahan ke tingkat pelayanan yang lebih tinggi. Rujukan horizontal dilakukan antar-fasilitas pada tingkat yang sama.","source":"Sistem Pelayanan, hlm. 14, 17–18","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q005","domain":"E","kind":"app","tier":1,"question":"Seorang pasien dewasa yang mampu mengambil keputusan menolak tindakan setelah menerima penjelasan. Perawat tidak setuju, tetapi tetap menghormati keputusan pasien dan menyampaikan konsekuensi secara jelas. Prinsip yang paling langsung dihormati adalah ...","options":["Fidelity","Justice","Autonomy","Accountability"],"answer":2,"explanation":"Otonomi menghormati hak klien untuk menentukan pilihan setelah memperoleh informasi yang memadai. Perawat tetap perlu memastikan pemahaman dan mendokumentasikan prosesnya.","source":"Etik dan Legal, hlm. 4, 23","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q006","domain":"H","kind":"concept","tier":1,"question":"Paradigma keperawatan holistik dalam materi menempatkan manusia sebagai fokus utama. Hubungan yang paling tepat antara manusia, lingkungan, kesehatan, dan keperawatan adalah ...","options":["Keempatnya berdiri sendiri dan dinilai secara terpisah","Lingkungan hanya dipertimbangkan setelah penyakit sembuh","Manusia berinteraksi dengan lingkungan; keperawatan membantu mengoptimalkan kesehatan secara utuh","Semua jawaban benar"],"answer":2,"explanation":"Paradigma menggambarkan manusia sebagai pusat yang berinteraksi dengan lingkungan, kesehatan, dan pelayanan keperawatan. Keempat konsep saling memengaruhi.","source":"Holistik, hlm. 4–9","trap":true,"tierLabel":"Fondasi analitis"},{"id":"Q007","domain":"I","kind":"app","tier":1,"question":"Dalam rapat asuhan, seorang perawat mengetahui fungsi MPP adalah menjaga kesinambungan pelayanan dan koordinasi lintas PPA. Pernyataan yang paling tepat mengenai MPP menurut materi adalah ...","options":["MPP menjadi PPA aktif yang menetapkan seluruh diagnosis medis","MPP menggantikan peran DPJP sebagai pemimpin klinis","MPP menjaga koordinasi dan kesinambungan asuhan, tetapi bukan PPA aktif","MPP hanya bertugas menyusun resep dan rekonsiliasi obat"],"answer":2,"explanation":"Materi IPC membedakan MPP dari PPA aktif. MPP mengoordinasikan kesinambungan asuhan dan perencanaan pelayanan, sedangkan DPJP memimpin dan memverifikasi rencana klinis.","source":"IPC, slide 7","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q008","domain":"P","kind":"app","tier":1,"question":"Diagnosis keperawatan telah dirumuskan. Perawat kemudian menyepakati prioritas masalah, tujuan, serta tindakan bersama klien dan mendokumentasikannya. Tahap proses keperawatan yang dilakukan adalah ...","options":["Pengkajian","Perencanaan","Evaluasi","Pengumpulan data sekunder"],"answer":1,"explanation":"Perencanaan berisi penetapan prioritas masalah, tujuan, dan rencana tindakan yang disusun bersama klien serta didokumentasikan.","source":"Standar Praktik, hlm. 13","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q009","domain":"S","kind":"app","tier":1,"question":"Sebuah puskesmas membutuhkan pemeriksaan penunjang yang tidak tersedia. Rumah sakit lain pada tingkat layanan yang sama memiliki alat dan tenaga yang dibutuhkan. Arah rujukan tersebut termasuk ...","options":["Vertikal karena pasien berpindah tempat","Horizontal karena perpindahan antar-fasilitas pada tingkat yang sama","Rujukan medis ke tingkat tersier","Rujukan kesehatan untuk pencegahan"],"answer":1,"explanation":"Rujukan horizontal berlangsung antar-layanan kesehatan pada tingkat yang sama ketika fasilitas asal tidak mampu memenuhi kebutuhan karena keterbatasan alat, fasilitas, atau tenaga.","source":"Sistem Pelayanan, hlm. 18","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q010","domain":"H","kind":"app","tier":1,"question":"Ruang rawat pasien panas, pengap, bising, dan kurang bersih. Berdasarkan teori lingkungan Florence Nightingale, tindakan awal yang paling sesuai adalah ...","options":["Memusatkan perhatian pada edukasi spiritual saja","Memperbaiki ventilasi, kebersihan, pencahayaan, dan pengendalian kebisingan","Meminta pasien mengabaikan kondisi ruangan","Mengutamakan pemeriksaan laboratorium tambahan"],"answer":1,"explanation":"Nightingale menekankan lingkungan fisik, psikologis, dan sosial. Udara bersih, pencahayaan, kehangatan, kebersihan, pengendalian kebisingan, dan nutrisi mendukung penyembuhan.","source":"Holistik, hlm. 11","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q011","domain":"P","kind":"standard","tier":1,"question":"Unit keperawatan menetapkan indikator mutu, mengumpulkan dan menganalisis data, menyusun rekomendasi, lalu memantau rencana tindak lanjut. Aktivitas ini paling sesuai dengan standar kinerja profesional ...","options":["Pendidikan","Jaminan mutu","Kesejawatan","Pemanfaatan sumber"],"answer":1,"explanation":"Standar jaminan mutu mencakup evaluasi sistematis terhadap mutu dan efektivitas praktik, indikator pemantauan, analisis data, umpan balik, rekomendasi, dan tindak lanjut.","source":"Standar Praktik, hlm. 17–20","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q012","domain":"I","kind":"app","tier":1,"question":"Perawat melaporkan kondisi pasien kepada DPJP dengan menyampaikan keadaan terkini, riwayat relevan, hasil penilaian, dan usulan tindak lanjut. Urutan komunikasi yang digunakan adalah ...","options":["TBaK","SBAR","CPPT","Semua jawaban benar"],"answer":1,"explanation":"SBAR membantu pelaporan terstruktur: Situation, Background, Assessment, Recommendation. TBaK digunakan untuk instruksi lisan atau telepon.","source":"IPC, slide 13","trap":true,"tierLabel":"Fondasi analitis"},{"id":"Q013","domain":"S","kind":"concept","tier":1,"question":"Dalam definisi sistem kesehatan WHO yang tercantum pada materi, istilah supply side dan demand side masing-masing merujuk pada ...","options":["Pembiayaan dan teknologi","Penyedia layanan dan orang yang menggunakan layanan","Tenaga kesehatan dan fasilitas","Pemerintah dan organisasi profesi"],"answer":1,"explanation":"Supply side adalah jaringan penyedia pelayanan kesehatan, sedangkan demand side adalah orang-orang yang menggunakan pelayanan tersebut.","source":"Sistem Pelayanan, hlm. 2","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q014","domain":"H","kind":"case","tier":1,"question":"Seorang klien meminta waktu dan privasi untuk menjalankan ibadah sesuai keyakinannya. Tidak ada kontraindikasi keselamatan yang diketahui. Respons perawat yang paling holistik adalah ...","options":["Menganggap kebutuhan tersebut di luar pelayanan keperawatan","Memfasilitasi sesuai keinginan klien dan kondisi klinis sambil menjaga privasi","Mengganti kebutuhan spiritual dengan aktivitas fisik","Meminta keluarga menentukan keyakinan yang harus diikuti klien"],"answer":1,"explanation":"Asuhan holistik memasukkan dimensi spiritual dan budaya. Perawat menanyakan kebutuhan klien, tidak berasumsi, lalu memfasilitasi secara aman dan menghormati pilihan klien.","source":"Holistik, hlm. 21–23","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q015","domain":"P","kind":"standard","tier":1,"question":"Setelah intervensi dilakukan, perawat mencatat tindakan dan respons klien secara sistematis agar dapat ditelusuri kembali. Hal ini merupakan salah satu kriteria hasil dari standar ...","options":["Implementasi","Pengkajian awal saja","Pendidikan profesional","Riset"],"answer":0,"explanation":"Standar implementasi menuntut dokumentasi tindakan dan respons klien secara sistematik serta bukti terukur pencapaian tujuan.","source":"Standar Praktik, hlm. 14","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q016","domain":"I","kind":"app","tier":1,"question":"Dalam tim interprofesi, tenaga kesehatan perlu memahami batas kompetensi sendiri dan mengetahui kapan harus meminta keahlian profesi lain. Kompetensi inti IPEC yang paling terkait adalah ...","options":["Nilai dan etika","Peran dan tanggung jawab","Komunikasi","Tim dan kerja tim"],"answer":1,"explanation":"Domain Roles & Responsibilities menekankan pemahaman peran dan tanggung jawab sendiri maupun profesi lain, termasuk kapan berkonsultasi.","source":"IPC, slide 9","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q017","domain":"S","kind":"app","tier":1,"question":"Sebuah layanan kesehatan tersedia sepanjang waktu, tidak terputus, dan dapat digunakan ketika dibutuhkan. Syarat pokok pelayanan yang ditunjukkan adalah ...","options":["Bermutu","Dapat diterima","Tersedia dan berkesinambungan","Mudah dijangkau secara biaya"],"answer":2,"explanation":"Materi menyebut syarat pokok: tersedia dan berkesinambungan, dapat diterima dan wajar, mudah dicapai, mudah dijangkau, dan bermutu.","source":"Sistem Pelayanan, hlm. 13","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q018","domain":"I","kind":"case","tier":1,"question":"Dokter mengira perawat sudah menyampaikan status puasa pasien kepada dietisien. Perawat mengira informasi itu tercantum di catatan yang telah dibaca, sementara dietisien masih menyusun rencana makan. Titik kegagalan IPC yang paling mendasar adalah ...","options":["Tidak adanya pembagian jadwal dinas antarprofesi","Asumsi bahwa informasi telah diterima tanpa komunikasi dan konfirmasi langsung","Keterlibatan pasien dalam pembahasan rencana asuhan","Semua jawaban benar"],"answer":1,"explanation":"Tim tidak boleh mengandalkan asumsi bahwa profesi lain telah membaca atau menerima informasi penting. Informasi status puasa perlu disampaikan secara jelas, tepat waktu, dan dikonfirmasi agar rencana diet maupun tindakan tetap aman.","source":"IPC, slide 1, 8, 13–15","trap":true,"tierLabel":"Fondasi analitis"},{"id":"Q019","domain":"P","kind":"app","tier":1,"question":"Data pengkajian menunjukkan masalah, penyebab, serta tanda dan gejala. Perawat kemudian memvalidasi rumusan bersama klien bila memungkinkan dan meninjau ulang berdasarkan data terbaru. Standar yang sedang diterapkan adalah ...","options":["Diagnosis keperawatan","Perencanaan","Implementasi","Jaminan mutu"],"answer":0,"explanation":"Standar diagnosis mencakup analisis dan interpretasi data, identifikasi masalah, rumusan P-E-S atau P-E, validasi, serta revisi berdasarkan data terbaru.","source":"Standar Praktik, hlm. 11–12","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q020","domain":"I","kind":"concept","tier":1,"question":"Dalam kompetensi inti IPEC, seorang perawat tetap menghormati pandangan profesi lain, menjaga privasi pasien, dan menempatkan nilai pasien sebagai dasar hubungan kerja tim. Perilaku tersebut paling dekat dengan domain ...","options":["Values and Ethics","Roles and Responsibilities","Communication","Teams and Teamwork"],"answer":0,"explanation":"Values and Ethics menekankan nilai bersama, sikap saling menghormati, dan perilaku etis dalam kolaborasi, termasuk menjaga privasi pasien.","source":"IPC, slide 9","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q021","domain":"I","kind":"case","tier":1,"question":"Dokter memberikan instruksi melalui telepon. Perawat menuliskan instruksi, membacakan kembali, lalu dokter membenarkan isi instruksi tersebut. Rangkaian ini menunjukkan ...","options":["SBAR lengkap","TBaK yang telah dikonfirmasi","Handover antarshift","Case conference"],"answer":1,"explanation":"TBaK terdiri dari Tulis, Baca Kembali, dan Konfirmasi. Tujuannya mengurangi salah tafsir pada instruksi lisan atau telepon.","source":"IPC, slide 13","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q022","domain":"S","kind":"app","tier":1,"question":"Sebuah program menghubungkan warga dengan kegiatan kesehatan yang dilaksanakan berbasis komunitas, bukan hanya di ruang rawat rumah sakit. Jenis lembaga yang paling sesuai dalam daftar materi adalah ...","options":["Hospice","Community Based Agency","Institusi rawat inap","Rawat jalan spesialistik"],"answer":1,"explanation":"Community Based Agency merupakan salah satu lembaga pelayanan kesehatan yang memberi layanan berbasis komunitas.","source":"Sistem Pelayanan, hlm. 10","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q023","domain":"P","kind":"standard","tier":1,"question":"Perawat mengikuti seminar, diskusi ilmiah, dan ronde keperawatan untuk memperbarui pengetahuan serta keterampilannya. Ini merupakan penerapan standar kinerja profesional ...","options":["Penilaian kerja","Pendidikan","Kesejawatan","Pemanfaatan sumber-sumber"],"answer":1,"explanation":"Standar pendidikan menuntut perawat memperoleh ilmu mutakhir, belajar mandiri, mengikuti pelatihan, seminar, diskusi ilmiah, dan kegiatan pengembangan kompetensi.","source":"Standar Praktik, hlm. 21–22","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q024","domain":"H","kind":"app","tier":1,"question":"Perawat membangun hubungan terapeutik dengan mendengarkan pasien, menunjukkan empati, menjaga martabat, dan mendukung kebutuhan emosional serta spiritualnya. Pendekatan ini paling dekat dengan teori ...","options":["Betty Neuman","Jean Watson","Florence Nightingale","Callista Roy"],"answer":1,"explanation":"Jean Watson menekankan human caring, kesatuan mind-body-spirit, sikap empati, penghargaan martabat, komunikasi terapeutik, dan lingkungan perawatan yang mendukung.","source":"Holistik, hlm. 13 dan 18","trap":false,"tierLabel":"Fondasi analitis"},{"id":"Q025","domain":"I","kind":"concept","tier":1,"question":"Sekelompok profesi bekerja pada pasien yang sama, tetapi setiap profesi menetapkan tujuan dan keputusan sendiri dengan komunikasi terbatas. Pola ini disebut ...","options":["Interprofesi","Transprofesi","Multiprofesi","Semua jawaban benar"],"answer":2,"explanation":"Multiprofesi menggambarkan profesi yang bekerja paralel dengan tujuan masing-masing. Interprofesi memerlukan interaksi, berbagi informasi, dan keputusan bersama.","source":"IPC, slide 2","trap":true,"tierLabel":"Fondasi analitis"},{"id":"Q026","domain":"S","kind":"case","tier":2,"question":"Pasien dari puskesmas membutuhkan tindakan spesialistik yang hanya tersedia di rumah sakit tingkat kedua. Penempatan layanan yang tepat menunjukkan bahwa tingkat kedua terutama menyediakan ...","options":["Pelayanan dasar oleh fasilitas tingkat pertama","Pelayanan spesialistik oleh dokter spesialis","Pelayanan subspesialistik oleh dokter subspesialis","Pelayanan promosi kesehatan berbasis keluarga saja"],"answer":1,"explanation":"Tingkat pertama menyediakan pelayanan dasar, tingkat kedua menyediakan pelayanan spesialistik oleh dokter spesialis, dan tingkat ketiga menyediakan layanan subspesialistik.","source":"Sistem Pelayanan, hlm. 11, 17","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q027","domain":"H","kind":"case","tier":2,"question":"Klien merasa cemas karena dukungan keluarganya terbatas dan ia memiliki kebiasaan budaya tertentu terkait makanan. Tanda vital stabil. Pengkajian lanjutan yang paling mencerminkan dimensi holistik adalah ...","options":["Mengkaji pola makan saja lalu menetapkan larangan","Menggali sumber dukungan sosial, keyakinan budaya, dan kecemasan sebelum menyusun penyesuaian asuhan","Menganggap kecemasan sebagai respons yang tidak relevan","Menyerahkan seluruh pengkajian kepada keluarga"],"answer":1,"explanation":"Asesmen holistik memasukkan dimensi psikologis, sosial-kultural, dan fisik. Preferensi pasien perlu digali dan divalidasi, bukan diasumsikan.","source":"Holistik, hlm. 20–23","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q028","domain":"I","kind":"app","tier":2,"question":"Pada rekam medis elektronik, setiap PPA mencatat perkembangan pasien dan membaca catatan profesi lain untuk menjaga kesinambungan asuhan. Dokumen terintegrasi yang dimaksud adalah ...","options":["Catatan pribadi perawat yang tidak dibagikan","CPPT","Daftar jadwal jaga","Lembar administrasi pembiayaan"],"answer":1,"explanation":"CPPT adalah catatan perkembangan pasien terintegrasi yang ditulis dan dibaca oleh seluruh PPA untuk mendukung koordinasi asuhan.","source":"IPC, slide 7; Permenkes 24/2022 disebut pada slide 6","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q029","domain":"P","kind":"standard","tier":2,"question":"Dalam menilai kelengkapan pengkajian, seorang perawat preseptor menemukan bahwa data sudah mencakup nyeri, tidur, dukungan keluarga, dan keyakinan pasien, tetapi belum mencatat respons terhadap terapi serta harapan kesehatan klien. Perbaikan yang paling sesuai standar adalah ...","options":["Menganggap data sudah memadai karena keluhan utama telah dicatat","Melengkapi data yang belum dikaji agar dasar diagnosis mencakup respons terapi dan harapan kesehatan","Menghapus data sosial dan spiritual agar format lebih ringkas","Memindahkan data tersebut ke tahap evaluasi tanpa memperbarui pengkajian"],"answer":1,"explanation":"Standar I mengharuskan data akurat, terkini, relevan dan menyeluruh, termasuk respons terhadap terapi dan harapan klien. Pengkajian yang tidak lengkap dapat melemahkan diagnosis serta rencana asuhan.","source":"Standar Praktik, hlm. 9–10","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q030","domain":"E","kind":"app","tier":2,"question":"Perawat diminta melakukan tindakan yang menurut penilaiannya berisiko menambah bahaya bagi klien, padahal ada cara yang lebih aman sesuai kewenangan. Prinsip yang seharusnya menjadi pertimbangan utama adalah ...","options":["Nonmaleficence","Fidelity","Veracity","Justice"],"answer":0,"explanation":"Nonmaleficence berarti tidak merugikan. Perawat perlu menghindari tindakan yang dapat menimbulkan bahaya dan mengupayakan alternatif yang lebih aman.","source":"Etik dan Legal, hlm. 4","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q031","domain":"I","kind":"concept","tier":2,"question":"Empat kompetensi inti IPEC 2023 yang disebut dalam materi adalah ...","options":["Kepemimpinan, advokasi, riset, dan manajemen biaya","Nilai dan etika; peran dan tanggung jawab; komunikasi; tim dan kerja tim","Pengkajian, diagnosis, perencanaan, dan evaluasi","Pencegahan, promosi, pemulihan, dan rehabilitasi"],"answer":1,"explanation":"IPEC Version 3 memuat empat kompetensi: Values & Ethics, Roles & Responsibilities, Communication, serta Teams & Teamwork.","source":"IPC, slide 9","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q032","domain":"H","kind":"app","tier":2,"question":"Klien meminta makanan yang sesuai kebiasaan budayanya. Menu tersebut perlu disesuaikan karena ada batasan klinis tertentu. Menurut perspektif asuhan lintas budaya Madeleine Leininger, respons yang paling tepat adalah ...","options":["Menolak seluruh kebiasaan budaya tanpa diskusi","Mempertahankan semua kebiasaan tanpa menilai keselamatan","Menegosiasikan penyesuaian yang aman sambil menghormati nilai budaya klien","Meminta klien meninggalkan identitas budayanya selama dirawat"],"answer":2,"explanation":"Leininger menekankan asuhan yang selaras budaya. Perawat dapat mempertahankan, menegosiasikan, atau mengubah praktik sesuai kebutuhan dan keselamatan klien.","source":"Holistik, hlm. 18","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q033","domain":"S","kind":"app","tier":2,"question":"Kegiatan imunisasi bagi kelompok rentan dilakukan sebelum timbulnya tanda penyakit tertentu. Berdasarkan tingkat pelayanan kesehatan Leavell dan Clark, kegiatan tersebut paling tepat digolongkan sebagai ...","options":["Diagnosis dini dan pengobatan segera","Perlindungan khusus","Rehabilitasi","Pemulihan tersier"],"answer":1,"explanation":"Specific Protection atau perlindungan khusus termasuk tingkat pelayanan kesehatan preventif dalam kerangka Leavell dan Clark.","source":"Sistem Pelayanan, hlm. 7","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q034","domain":"P","kind":"standard","tier":2,"question":"Dalam merumuskan diagnosis, perawat menggunakan komponen masalah (P), penyebab (E), dan tanda/gejala (S), lalu memeriksa apakah diagnosis relevan dengan data. Rumusan yang digunakan mengikuti ...","options":["Pola P-E-S atau P-E","Format evaluasi hasil intervensi","Urutan komunikasi SBAR","Semua jawaban benar"],"answer":0,"explanation":"Materi menyebut komponen diagnosis keperawatan berupa masalah (P), penyebab (E), tanda/gejala (S), atau masalah dengan penyebab (P-E).","source":"Standar Praktik, hlm. 11","trap":true,"tierLabel":"Penerapan klinis"},{"id":"Q035","domain":"I","kind":"case","tier":2,"question":"Pada persiapan tindakan, dokter tidak mengetahui bahwa pasien telah dipuasakan. Dietisien juga belum menerima informasi perubahan status nutrisi. Masalah utama yang tampak adalah ...","options":["Kurangnya dokumentasi administratif pasien semata","Informasi penting tidak dibagikan dan koordinasi antarprofesi tidak berjalan","Pasien belum menjadi bagian dari tim karena belum pulang","Ketidakjelasan diagnosis medis oleh apoteker"],"answer":1,"explanation":"Kasus IPC menyoroti asumsi antarprofesi dan informasi yang tidak tersampaikan. Tim perlu berbagi informasi secara terbuka dan tepat waktu untuk mencegah risiko keselamatan.","source":"IPC, pembuka kasus dan slide 11–14","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q036","domain":"P","kind":"app","tier":2,"question":"Tujuan asuhan telah ditetapkan, tetapi pasien menunjukkan respons yang tidak sesuai harapan setelah tindakan. Perawat kemudian menyesuaikan tindakan berdasarkan respons tersebut. Prinsip pelaksanaan yang tampak adalah ...","options":["Implementasi harus sama persis meski respons berubah","Implementasi ditinjau ulang dan direvisi berdasarkan respons klien","Evaluasi hanya dilakukan saat pasien pulang","Perencanaan tidak boleh melibatkan klien"],"answer":1,"explanation":"Standar implementasi mengharuskan perawat mengkaji ulang dan merevisi tindakan berdasarkan respons klien, serta mendokumentasikan tindakan dan hasilnya.","source":"Standar Praktik, hlm. 14","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q037","domain":"H","kind":"case","tier":2,"question":"Seorang pasien pascastroke mengalami penurunan fungsi, kehilangan peran dalam keluarga, dan kesulitan menyesuaikan diri. Perawat membantu pasien membangun kembali fungsi tubuh, konsep diri, peran, dan relasi. Teori yang paling sesuai adalah ...","options":["Florence Nightingale","Callista Roy","Jean Watson","Madeleine Leininger"],"answer":1,"explanation":"Model adaptasi Roy berfokus pada dukungan terhadap adaptasi individu dalam fungsi fisiologis, konsep diri, peran, dan relasi.","source":"Holistik, hlm. 18","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q038","domain":"E","kind":"concept","tier":2,"question":"Dalam praktik keperawatan, hukum berfungsi antara lain untuk ...","options":["Menghapus tanggung jawab perawat ketika bekerja dalam tim","Menetapkan batas kegiatan praktik yang legal dan membedakan tanggung jawab antarprofesi","Menggantikan seluruh standar praktik profesional","Membolehkan perawat menjalankan tindakan di luar kompetensi"],"answer":1,"explanation":"Hukum memberi kerangka kegiatan yang legal, membedakan tanggung jawab perawat dari profesi lain, menetapkan batas praktik, dan mempertahankan akuntabilitas.","source":"Etik dan Legal, hlm. 18–20","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q039","domain":"I","kind":"app","tier":2,"question":"Saat visite bersama, perawat mengetahui pasien akan menjalani tindakan dan harus berpuasa. Dietisien belum menerima informasi tersebut, sedangkan dokter mengira hal itu sudah disampaikan. Langkah koordinasi yang paling tepat adalah ...","options":["Membiarkan dietisien membaca sendiri seluruh catatan saat ada waktu","Menghubungi dietisien dan tim terkait untuk menyampaikan status puasa, mengonfirmasi pemahaman, lalu memperbarui dokumentasi terintegrasi","Meminta keluarga menyampaikan informasi antarprofesi","Mengubah rencana diet sendiri tanpa konsultasi karena perawat berada dekat pasien"],"answer":1,"explanation":"Kolaborasi memerlukan pembagian informasi aktif dan tepat waktu, pemahaman peran, serta dokumentasi terintegrasi. Perawat menjadi penghubung informasi, tetapi tetap bekerja sesuai kewenangannya.","source":"IPC, slide 8, 12–15","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q040","domain":"I","kind":"case","tier":2,"question":"Dalam rapat klinis, dokter, perawat, dan apoteker mendiskusikan informasi pasien yang sama, menyelaraskan tujuan, dan memutuskan rencana secara bersama dengan melibatkan pasien. Pola kerja tersebut adalah ...","options":["Multiprofesi","Interprofesi","Kerja paralel tanpa koordinasi","Semua jawaban benar"],"answer":1,"explanation":"Kolaborasi interprofesi terjadi ketika profesi saling berinteraksi, berbagi informasi, dan menyepakati tujuan serta rencana bersama dengan pasien sebagai mitra.","source":"IPC, slide 2","trap":true,"tierLabel":"Penerapan klinis"},{"id":"Q041","domain":"P","kind":"standard","tier":2,"question":"Rencana asuhan keperawatan disusun hanya berdasarkan diagnosis umum tanpa mempertimbangkan kondisi dan preferensi pasien yang berbeda. Prinsip standar perencanaan yang paling jelas belum dipenuhi adalah ...","options":["Perencanaan bersifat individual sesuai kondisi dan kebutuhan klien","Perawat harus selalu menghindari dokumentasi rencana","Rencana tidak perlu mencerminkan diagnosis","Tujuan hanya ditentukan oleh petugas"],"answer":0,"explanation":"Standar perencanaan menuntut rencana yang individual untuk individu, kelompok, atau masyarakat sesuai kondisi dan kebutuhan klien serta disusun bersama klien.","source":"Standar Praktik, hlm. 13","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q042","domain":"H","kind":"app","tier":2,"question":"Seorang klien menghadapi stresor keluarga dan lingkungan yang mengganggu proses adaptasinya. Perawat mengenali stresor, menilai respons, dan membantu klien beradaptasi. Kerangka teori yang paling sesuai adalah ...","options":["Model adaptasi Roy","Model lingkungan Nightingale saja","Teori caring Watson saja","Model budaya Leininger saja"],"answer":0,"explanation":"Roy menitikberatkan adaptasi; dalam kasus, intervensi diarahkan pada kemampuan klien menanggapi perubahan dan menyesuaikan diri.","source":"Holistik, hlm. 18","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q043","domain":"I","kind":"app","tier":2,"question":"Pasien dengan penyakit kronis mulai direncanakan pulang sejak awal rawat. Tim menyepakati edukasi keluarga, kebutuhan alat, dan kesinambungan layanan setelah pasien di rumah. Bentuk IPC yang paling sesuai adalah ...","options":["Case conference","Discharge planning","Huddle","Rekonsiliasi obat saja"],"answer":1,"explanation":"Discharge planning merupakan perencanaan pulang sejak awal rawat, termasuk edukasi keluarga dan kesinambungan asuhan setelah keluar dari fasilitas.","source":"IPC, slide 15","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q044","domain":"S","kind":"concept","tier":2,"question":"Dua fasilitas kesehatan pada tingkat layanan yang sama saling merujuk karena satu fasilitas tidak memiliki alat atau tenaga yang diperlukan. Pernyataan yang membedakan rujukan ini dari rujukan vertikal adalah ...","options":["Tujuannya selalu menuju dokter subspesialis","Arah rujukan antarfasilitas tetap berada pada tingkat yang sama","Rujukan horizontal hanya digunakan pada kondisi bencana","Rujukan horizontal tidak memerlukan indikasi"],"answer":1,"explanation":"Rujukan horizontal terjadi antar layanan pada tingkat yang sama karena keterbatasan fasilitas, peralatan, atau ketenagaan. Rujukan vertikal menuju tingkat lebih tinggi.","source":"Sistem Pelayanan, hlm. 18","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q045","domain":"P","kind":"standard","tier":2,"question":"Perawat menilai apakah tujuan asuhan telah tercapai, membandingkan data dasar dengan respons terbaru, lalu memperbarui diagnosis dan rencana bila perlu. Kegiatan ini menunjukkan standar ...","options":["Pengkajian awal","Evaluasi","Pendidikan","Kesejawatan"],"answer":1,"explanation":"Evaluasi menilai perkembangan kesehatan klien terhadap tujuan, memvalidasi data baru, dan menjadi dasar revisi data, diagnosis, serta rencana tindakan.","source":"Standar Praktik, hlm. 15–16","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q046","domain":"P","kind":"standard","tier":2,"question":"Dalam audit dokumentasi, ditemukan diagnosis keperawatan yang tetap digunakan meskipun kondisi pasien telah berubah dan data pengkajian belum diperbarui. Tindakan koreksi yang paling sesuai standar profesional adalah ...","options":["Mempertahankan diagnosis agar kesinambungan catatan tidak terganggu","Melakukan pengkajian ulang, menganalisis data terbaru, lalu memvalidasi dan merevisi diagnosis bila diperlukan","Menghapus diagnosis lama tanpa menilai data baru","Menunggu evaluasi akhir perawatan sebelum mengubah seluruh dokumentasi"],"answer":1,"explanation":"Standar diagnosis mengharuskan kaji ulang dan revisi berdasarkan data terbaru serta validasi bersama klien/sejawat bila memungkinkan. Data yang mutakhir menjadi dasar rencana asuhan yang sesuai.","source":"Standar Praktik, hlm. 11–12","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q047","domain":"S","kind":"app","tier":2,"question":"Pasien datang ke instalasi gawat darurat dengan kondisi yang memerlukan penanganan segera. Berdasarkan materi sistem rujukan berjenjang, keadaan ini termasuk ...","options":["Alasan untuk tetap menunggu rujukan berjenjang tanpa pengecualian","Salah satu pengecualian rujukan berjenjang","Rujukan horizontal secara otomatis","Rujukan kesehatan nonklinis"],"answer":1,"explanation":"Keadaan gawat darurat termasuk pengecualian rujukan berjenjang, bersama bencana, kekhususan masalah kesehatan, pertimbangan geografis, dan ketersediaan fasilitas.","source":"Sistem Pelayanan, hlm. 23","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q048","domain":"I","kind":"app","tier":2,"question":"Saat serah terima antarshift, perawat menyampaikan perubahan kondisi, tindakan yang telah dilakukan, dan hal yang perlu dipantau secara singkat agar tim berikutnya memiliki pemahaman yang sama. Bentuk kerja tim yang paling sesuai adalah ...","options":["Handover","Pendidikan interprofesi","Penilaian kerja","Rujukan vertikal"],"answer":0,"explanation":"Handover merupakan serah terima yang membantu menyamakan informasi antarpetugas. Materi juga menyebut huddle sebagai briefing singkat.","source":"IPC, slide 15","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q049","domain":"H","kind":"case","tier":2,"question":"Pasien mengeluh nyeri berat dan menolak tindakan karena takut, sementara keluarga mengatakan pasien biasanya tidak pernah mengeluh. Sebelum menyimpulkan penyebab penolakan, perawat sebaiknya ...","options":["Mendahulukan penafsiran keluarga karena lebih mengenal pasien","Menggali pengalaman pasien, memvalidasi data, dan mengeksplorasi kebutuhan fisik serta psikologis","Menyatakan pasien tidak kooperatif","Mengabaikan pengalaman subjektif karena nyeri dapat diukur"],"answer":1,"explanation":"Materi menggambarkan masalah pasien seperti gunung es: hal yang tampak belum mewakili seluruh kebutuhan. Perawat perlu mendengar, tidak berasumsi, dan memvalidasi data bersama pasien.","source":"Holistik, hlm. 17, 20","trap":false,"tierLabel":"Penerapan klinis"},{"id":"Q050","domain":"E","kind":"case","tier":2,"question":"Pasien menolak pengobatan yang direkomendasikan. Tim berbeda pendapat tentang keputusan berikutnya. Urutan awal pengambilan keputusan legal-etik yang sesuai materi adalah ...","options":["Menetapkan sanksi, lalu meminta persetujuan pasien","Mengidentifikasi masalah etik, menganalisis prinsip yang terlibat, dan melibatkan tim multidisiplin","Mengikuti keputusan profesi dengan jabatan tertinggi","Semua jawaban benar"],"answer":1,"explanation":"Materi menguraikan proses: identifikasi masalah etik, analisis prinsip etik yang relevan, pelibatan tim multidisiplin, lalu evaluasi dampak keputusan.","source":"Etik dan Legal, hlm. 23","trap":true,"tierLabel":"Penerapan klinis"},{"id":"Q051","domain":"P","kind":"standard","tier":3,"question":"Perawat menyimpan catatan rencana tindakan secara tertulis, singkat, mudah ditemukan, dan menunjukkan revisi bila tujuan belum tercapai. Kualitas ini merupakan kriteria hasil dari standar ...","options":["Perencanaan","Riset","Pendidikan","Kesejawatan"],"answer":0,"explanation":"Rencana asuhan harus terdokumentasi, mudah diperoleh, mencerminkan penyelesaian diagnosis, dan memperlihatkan revisi pencapaian tujuan.","source":"Standar Praktik, hlm. 13","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q052","domain":"P","kind":"case","tier":3,"question":"Setelah beberapa hari intervensi, keluhan pasien berkurang tetapi muncul data baru berupa kesulitan mobilisasi. Tujuan lama hanya menilai nyeri. Langkah evaluasi yang paling tepat adalah ...","options":["Mempertahankan rencana lama karena salah satu keluhan membaik","Menganalisis data baru bersama klien, memperbarui diagnosis, dan menyesuaikan rencana asuhan","Menghentikan seluruh intervensi tanpa dokumentasi","Mencatat keberhasilan tanpa mengukur tujuan lain"],"answer":1,"explanation":"Evaluasi bersifat dinamis. Data dan respons terbaru dianalisis, divalidasi bersama klien/sejawat, lalu digunakan untuk merevisi data dasar, diagnosis, dan perencanaan.","source":"Standar Praktik, hlm. 15–16","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q053","domain":"I","kind":"app","tier":3,"question":"DPJP memimpin integrasi dan memverifikasi rencana asuhan seluruh PPA, sementara perawat sebagai PPJA menjalankan asuhan keperawatan dan mengoordinasikan informasi pasien. Pembagian ini menunjukkan ...","options":["Penghapusan tanggung jawab profesi selain DPJP","Kejelasan peran dan tanggung jawab dalam asuhan terintegrasi","Pola multiprofesi tanpa komunikasi","Pemindahan seluruh tanggung jawab klinis kepada perawat"],"answer":1,"explanation":"Materi menetapkan DPJP sebagai clinical leader dan perawat/PPJA sebagai PPA yang berkolaborasi serta mencatat perkembangan di CPPT.","source":"IPC, slide 7 dan 18","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q054","domain":"H","kind":"concept","tier":3,"question":"Seorang klien memiliki diagnosis penyakit kronis, tetapi ia merasa sehat karena masih bekerja. Pada saat yang sama ia mengalami kecemasan dan perubahan peran keluarga. Ketiga sudut pandang yang perlu dibedakan untuk memahami pengalaman tersebut adalah ...","options":["Diagnosis, prognosis, dan terapi","Disease, illness, dan sickness","Promosi, proteksi, dan rehabilitasi","Adaptasi, koping, dan kepatuhan"],"answer":1,"explanation":"Materi menjelaskan disease sebagai dimensi biologis, illness sebagai pengalaman sakit yang subjektif/psikologis, dan sickness sebagai respons atau peran sosial terhadap penyakit.","source":"Holistik, hlm. 8","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q055","domain":"S","kind":"case","tier":3,"question":"Di wilayah terpencil, fasilitas rujukan tingkat lebih tinggi sangat jauh. Puskesmas mempertimbangkan rujukan berdasarkan kebutuhan klinis dan ketersediaan fasilitas. Faktor yang secara eksplisit disebut dalam materi sebagai pengecualian rujukan berjenjang adalah ...","options":["Preferensi petugas untuk mengurangi beban kerja","Pertimbangan geografis dan ketersediaan fasilitas","Keinginan pasien memilih dokter tanpa indikasi","Kelengkapan administrasi saja"],"answer":1,"explanation":"Pertimbangan geografis dan ketersediaan fasilitas termasuk pengecualian rujukan berjenjang dalam materi.","source":"Sistem Pelayanan, hlm. 23","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q056","domain":"P","kind":"standard","tier":3,"question":"Seorang perawat menyusun proposal sederhana untuk menguji apakah edukasi pulang meningkatkan pemahaman keluarga, kemudian mengumpulkan data, menilai hasil, dan membagikannya kepada sejawat. Standar kinerja yang paling terkait adalah ...","options":["Riset","Kesejawatan","Jaminan mutu saja","Pemanfaatan sumber"],"answer":0,"explanation":"Standar riset menuntut perawat berpartisipasi dalam pengembangan, implementasi, evaluasi, serta penyebarluasan hasil telaah atau riset sesuai tingkat pendidikan.","source":"Standar Praktik, hlm. 31–34","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q057","domain":"I","kind":"case","tier":3,"question":"Seorang pasien memiliki diabetes, luka kaki, masalah diet, dan keterbatasan mobilitas. Tim membahas tujuan bersama dengan pasien dan keluarga, lalu membagi intervensi sesuai kompetensi dokter, perawat, apoteker, dietisien, serta fisioterapis. Ciri utama praktik tersebut adalah ...","options":["Semua profesi melakukan tindakan yang sama agar mudah dinilai","Setiap profesi memberi kontribusi khusus dalam rencana yang terintegrasi","Keputusan diserahkan hanya kepada pasien tanpa dukungan profesi","Perawat mengambil alih kewenangan semua profesi"],"answer":1,"explanation":"Kolaborasi interprofesi memadukan keahlian sesuai peran, tujuan bersama, keputusan bersama, komunikasi, dan tanggung jawab kolektif dengan pasien sebagai mitra.","source":"IPC, slide 8, 15–16","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q058","domain":"E","kind":"app","tier":3,"question":"Perawat mengetahui bahwa prosedur yang dilakukan tidak sesuai dengan catatan yang dibuat. Ia segera menyampaikan kejadian secara jujur agar dapat dilakukan tindakan korektif. Prinsip etik yang paling tampak adalah ...","options":["Veracity dan accountability","Justice dan fidelity saja","Autonomy dan confidentiality saja","Beneficence tanpa kewajiban pelaporan"],"answer":0,"explanation":"Kejujuran (veracity) menuntut keterbukaan, sedangkan akuntabilitas menuntut tanggung jawab serta pencatatan dan pelaporan yang jujur atas kesalahan atau kekurangan.","source":"Etik dan Legal, hlm. 4, 14–15","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q059","domain":"H","kind":"app","tier":3,"question":"Pasien pascaoperasi mengeluh nyeri dan tidak dapat tidur. Ia juga khawatir kehilangan pekerjaan serta merasa jauh dari sumber dukungan spiritualnya. Rencana asuhan yang paling holistik adalah ...","options":["Mengutamakan obat nyeri dan menunda pembahasan kebutuhan lain","Mengkaji nyeri, kecemasan, dukungan sosial, makna spiritual, lalu menyepakati intervensi yang aman bersama pasien","Menyarankan pasien mengubah keyakinan agar mudah dirawat","Mengalihkan seluruh kebutuhan nonfisik kepada keluarga"],"answer":1,"explanation":"Asuhan holistik mengintegrasikan dimensi fisik, psikologis, sosial, spiritual, dan budaya. Kebutuhan digali melalui pertanyaan, divalidasi, lalu ditangani dengan keterlibatan pasien.","source":"Holistik, hlm. 20–23","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q060","domain":"S","kind":"standard","tier":3,"question":"Fasilitas pelayanan melakukan kegiatan mencegah penyakit dengan memberikan perlindungan khusus terhadap paparan tertentu. Dalam kerangka Leavell dan Clark, kegiatan ini merupakan ...","options":["Health promotion","Specific protection","Early diagnosis and prompt treatment","Rehabilitation"],"answer":1,"explanation":"Specific protection atau perlindungan khusus merupakan salah satu tingkat pelayanan kesehatan yang disebut Leavell dan Clark.","source":"Sistem Pelayanan, hlm. 7","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q061","domain":"P","kind":"standard","tier":3,"question":"Dalam rapat pengelolaan unit, perawat mempertimbangkan penggantian alat dengan pilihan yang lebih murah. Sebelum keputusan dibuat, aspek yang perlu dinilai secara bersamaan menurut standar pemanfaatan sumber adalah ...","options":["Biaya pengadaan dan kemudahan administrasi saja","Keamanan, efektivitas, dan biaya penggunaan bagi klien","Preferensi sebagian besar petugas tanpa penilaian klinis","Kecepatan pengadaan meskipun mutu belum diketahui"],"answer":1,"explanation":"Standar VIII meminta perawat mempertimbangkan keamanan, efektivitas, dan biaya saat merencanakan serta memberikan asuhan. Efisiensi tidak boleh mengorbankan keselamatan atau efektivitas.","source":"Standar Praktik, hlm. 35–37","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q062","domain":"I","kind":"app","tier":3,"question":"Mahasiswa keperawatan dan mahasiswa farmasi belajar bersama mengenai komunikasi obat, mempelajari peran masing-masing, lalu berlatih menyusun rencana asuhan secara kolaboratif. Kegiatan ini paling tepat disebut ...","options":["Multiprofessional staffing","Interprofessional Education (IPE)","Case conference pasien aktual","Transprofessional delegation"],"answer":1,"explanation":"IPE adalah dua profesi atau lebih belajar dari, tentang, dan bersama satu sama lain untuk meningkatkan kolaborasi dan mutu asuhan.","source":"IPC, slide 2 dan 4","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q063","domain":"I","kind":"standard","tier":3,"question":"Tim mengundang pasien dan keluarga sebagai mitra, menyepakati tujuan, menghargai kontribusi profesi lain, serta menjaga pertukaran informasi secara terbuka. Kombinasi tersebut terutama mencerminkan prinsip ...","options":["Kolaborasi interprofesi","Rujukan vertikal","Pendidikan mandiri","Multiprofesi"],"answer":0,"explanation":"Prinsip IPC mencakup berpusat pada pasien, kemitraan setara, saling menghormati, keterbukaan, akuntabilitas, dan kepatuhan etik-legal.","source":"IPC, slide 11","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q064","domain":"P","kind":"standard","tier":3,"question":"Data pengkajian berasal dari wawancara, observasi, pemeriksaan fisik, laboratorium, catatan medis, dan keluarga. Untuk menjaga keakuratan, standar pengkajian menuntut perawat ...","options":["Mengutamakan satu sumber data agar tidak terjadi perbedaan","Menganalisis data yang akurat, terkini, relevan, dan melibatkan partisipasi klien","Menghindari validasi karena dapat memperlambat pelayanan","Semua jawaban benar"],"answer":1,"explanation":"Pengkajian memanfaatkan berbagai sumber, melibatkan klien, dan menghasilkan data yang akurat, terkini, serta relevan.","source":"Standar Praktik, hlm. 9–10","trap":true,"tierLabel":"Analisis terintegrasi"},{"id":"Q065","domain":"H","kind":"concept","tier":3,"question":"Dalam model Neuman, intervensi pencegahan primer terutama diarahkan untuk ...","options":["Menangani akibat setelah sistem mengalami gangguan berat","Memperkuat perlindungan sebelum reaksi terhadap stresor muncul","Memulihkan fungsi setelah proses rehabilitasi selesai","Menggantikan seluruh mekanisme koping pasien"],"answer":1,"explanation":"Diagram Neuman pada materi membedakan pencegahan primer sebelum reaksi terhadap stresor, sekunder saat gejala muncul, dan tersier pada adaptasi serta pemulihan setelah pengobatan.","source":"Holistik, hlm. 12","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q066","domain":"S","kind":"case","tier":3,"question":"Pasien dengan kebutuhan layanan tertentu tidak dapat mencapai fasilitas karena hambatan jarak dan transportasi. Tim perlu mempertimbangkan pilihan rujukan yang sesuai dengan indikasi klinis dan kondisi wilayah. Pertimbangan ini menunjukkan bahwa sistem rujukan ...","options":["Hanya mengatur jenjang fasilitas dan tidak mempertimbangkan wilayah","Memiliki pengecualian yang dapat mempertimbangkan kondisi geografis","Mengharuskan semua pasien melewati setiap tingkat tanpa pengecualian","Dapat diganti oleh keputusan administratif keluarga"],"answer":1,"explanation":"Materi menyebut pertimbangan geografis sebagai salah satu pengecualian rujukan berjenjang. Keputusan tetap perlu disesuaikan dengan indikasi dan ketentuan layanan.","source":"Sistem Pelayanan, hlm. 18, 23","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q067","domain":"P","kind":"app","tier":3,"question":"Tim mutu menemukan angka dokumentasi respons pasien setelah tindakan belum lengkap. Mereka mengumpulkan data, membandingkan hasil terhadap indikator, memberikan umpan balik, dan menyusun rencana tindak lanjut. Aktivitas ini berbeda dari penilaian individu karena berfokus pada ...","options":["Pengendalian mutu dan efektivitas praktik keperawatan","Pengukuran kepuasan kerja seorang perawat saja","Penggantian diagnosis keperawatan","Penetapan tingkat rujukan pasien"],"answer":0,"explanation":"Jaminan mutu menilai mutu dan efektivitas praktik secara sistematis serta mengidentifikasi kesenjangan untuk diperbaiki di tingkat individu, unit, atau organisasi.","source":"Standar Praktik, hlm. 18–20","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q068","domain":"I","kind":"case","tier":3,"question":"Dalam penanganan pasien diabetes, apoteker perlu mengklarifikasi interaksi dan penggunaan insulin, sedangkan dietisien menilai kebutuhan gizi. Perawat tidak mengambil alih tugas kedua profesi, tetapi menghubungkan informasi dan memantau pasien. Kompetensi yang paling dominan adalah ...","options":["Peran dan tanggung jawab serta komunikasi kolaboratif","Pemindahan kewenangan profesi","Keputusan klinis tanpa konsultasi","Pemisahan informasi agar setiap profesi mandiri"],"answer":0,"explanation":"Perawat perlu memahami batas peran, berkonsultasi dengan profesi yang tepat, serta berbagi informasi secara bertanggung jawab.","source":"IPC, slide 9, 16, 18","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q069","domain":"E","kind":"app","tier":3,"question":"Perawat telah berjanji akan kembali pada waktu tertentu untuk membantu pasien, tetapi tidak memberi kabar ketika terlambat dan tidak menindaklanjuti janjinya. Prinsip etik yang paling langsung terkait adalah ...","options":["Fidelity","Justice","Veracity","Nonmaleficence"],"answer":0,"explanation":"Fidelity berarti menepati janji dan komitmen profesional kepada pasien.","source":"Etik dan Legal, hlm. 4","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q070","domain":"P","kind":"standard","tier":3,"question":"Perawat membahas kasus bersama sejawat, menelaah tindakan yang telah dilakukan, menyepakati perbaikan, dan menerapkan hasil pembahasan pada asuhan berikutnya. Standar kinerja yang tercermin adalah ...","options":["Kesejawatan (collegial)","Pendidikan","Penilaian kerja","Riset"],"answer":0,"explanation":"Standar kesejawatan menekankan kolaborasi antar-sejawat melalui telaah sejawat, kesepakatan, dan perbaikan tindakan berdasarkan hasil pertemuan.","source":"Standar Praktik, hlm. 25–26","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q071","domain":"H","kind":"app","tier":3,"question":"Klien mengungkapkan kebiasaan budaya yang penting baginya, tetapi satu kebiasaan dapat mengganggu keselamatan selama perawatan. Pendekatan paling tepat adalah ...","options":["Melarang seluruh praktik budaya tanpa penjelasan","Memahami makna kebiasaan, berdiskusi, lalu menegosiasikan penyesuaian yang aman","Mengikuti seluruh kebiasaan tanpa menilai risiko","Mengabaikan pernyataan klien karena fokus keperawatan adalah penyakit"],"answer":1,"explanation":"Asuhan holistik menghormati preferensi budaya, tetapi tetap memperhatikan keselamatan. Materi Leininger menyebut mempertahankan, menegosiasikan, atau mengubah praktik sesuai kebutuhan.","source":"Holistik, hlm. 18, 23","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q072","domain":"I","kind":"app","tier":3,"question":"Ketika konflik pendapat muncul antara dua profesi, pemimpin tim memberi kesempatan setiap pihak menyampaikan alasan, mengklarifikasi kewenangan, dan menyepakati tujuan pasien sebagai fokus. Pendekatan ini terutama menguatkan domain CIHC ...","options":["Mengelola perbedaan pendapat dan fungsi tim","Pencatatan keuangan dan sumber daya","Pengkajian individu oleh satu profesi","Pengalihan pasien ke layanan tersier"],"answer":0,"explanation":"CIHC 2024 mencakup domain klarifikasi dan negosiasi peran, fungsi tim, mengelola perbedaan pendapat, kepemimpinan kolaboratif, asuhan berfokus pada relasi, dan komunikasi tim.","source":"IPC, slide 10","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q073","domain":"S","kind":"app","tier":3,"question":"Seorang pasien membutuhkan layanan yang dapat diterima secara budaya, mudah dicapai, terjangkau, tersedia berkesinambungan, dan bermutu. Jika satu syarat tidak terpenuhi, konsekuensi yang paling mungkin pada sistem adalah ...","options":["Akses dan pemanfaatan layanan dapat terganggu meskipun komponen lain tersedia","Mutu layanan otomatis meningkat karena kebutuhan lebih sedikit","Sistem pembiayaan menggantikan kebutuhan tenaga kesehatan","Pasien tidak lagi membutuhkan koordinasi pelayanan"],"answer":0,"explanation":"Materi menyebut lima syarat pokok pelayanan kesehatan. Kegagalan salah satunya dapat menjadi hambatan bagi akses atau kualitas layanan.","source":"Sistem Pelayanan, hlm. 13","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q074","domain":"P","kind":"standard","tier":3,"question":"Perawat menemukan rumusan diagnosis tidak lagi sesuai setelah hasil pemeriksaan dan respons klien berubah. Perawat memvalidasi data baru dengan klien dan sejawat sebelum memperbarui diagnosis. Hal ini menunjukkan bahwa diagnosis keperawatan ...","options":["Merupakan keputusan tetap setelah pertama kali dicatat","Dapat ditinjau ulang dan direvisi berdasarkan data terbaru","Hanya ditentukan oleh profesi lain","Tidak perlu didokumentasikan bila sudah dibicarakan"],"answer":1,"explanation":"Standar diagnosis mengharuskan kaji ulang dan revisi berdasarkan data terbaru, validasi bila memungkinkan, serta dokumentasi untuk memandu asuhan.","source":"Standar Praktik, hlm. 11–12","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q075","domain":"I","kind":"case","tier":3,"question":"Perawat menganggap perubahan diet pasien sudah diketahui semua anggota tim sehingga tidak menyampaikannya. Akibatnya, rencana tindakan tidak sesuai dengan kondisi pasien. Strategi penguatan IPC yang paling langsung mengatasi masalah ini adalah ...","options":["Menambah jumlah rapat tanpa agenda","Menggunakan komunikasi terstruktur dan dokumentasi terintegrasi, serta mengonfirmasi informasi penting","Membiarkan tiap profesi mengandalkan asumsi masing-masing","Mengurangi keterlibatan pasien dalam keputusan"],"answer":1,"explanation":"Hambatan IPC termasuk komunikasi tidak terstruktur dan asumsi peran. SBAR, TBaK, huddle, briefing, RME, dan CPPT membantu informasi dibagikan dengan jelas.","source":"IPC, slide 13–14","trap":false,"tierLabel":"Analisis terintegrasi"},{"id":"Q076","domain":"I","kind":"case","tier":4,"question":"Pasien diabetes dengan ulkus kaki akan menjalani tindakan dan sedang dipuasakan. Perawat menerima instruksi insulin melalui telepon, tetapi dosisnya berbeda dengan resep. Dietisien belum mengetahui status puasa, sementara apoteker melihat ketidaksesuaian. Langkah pertama yang paling tepat adalah ...","options":["Melaksanakan dosis dari telepon karena instruksi lisan dianggap paling baru","Menghentikan sementara proses pemberian yang belum jelas, melakukan TBaK/klarifikasi kepada pemberi instruksi, dan menyampaikan perubahan status pasien melalui komunikasi terstruktur","Meminta dietisien menentukan dosis insulin","Mengubah dosis berdasarkan pengalaman perawat tanpa konsultasi"],"answer":1,"explanation":"Situasi ini menggabungkan risiko obat dan kegagalan koordinasi. Perbedaan instruksi harus diklarifikasi dengan TBaK; informasi klinis relevan dibagikan kepada PPA melalui komunikasi terstruktur seperti SBAR dan CPPT.","source":"IPC, pembuka kasus; slide 13, 16","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q077","domain":"P","kind":"app","tier":4,"question":"Hasil evaluasi menunjukkan tujuan penurunan nyeri tercapai, tetapi pasien belum mampu melakukan perawatan diri sebelum pulang. Keputusan yang paling sesuai dengan siklus proses keperawatan adalah ...","options":["Menutup asuhan karena satu tujuan telah tercapai","Melanjutkan pengkajian, menetapkan atau memperbarui diagnosis dan rencana, serta mengintegrasikan edukasi dan persiapan pulang","Mengulang intervensi nyeri dengan intensitas yang sama","Menunda dokumentasi hingga pasien pulang"],"answer":1,"explanation":"Evaluasi digunakan untuk mengambil keputusan dan merevisi data, diagnosis, rencana, serta intervensi. Kemandirian klien dan persiapan pulang perlu menjadi bagian dari kesinambungan asuhan.","source":"Standar Praktik, hlm. 15–16; IPC slide 15","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q078","domain":"H","kind":"case","tier":4,"question":"Seorang pasien menolak tindakan karena takut, memiliki dukungan sosial terbatas, dan menyebut keyakinan spiritual tertentu sebagai sumber kekuatannya. Dokter berfokus pada urgensi klinis, sementara keluarga meminta tindakan segera. Respons perawat yang paling mencerminkan asuhan holistik adalah ...","options":["Mengutamakan keputusan keluarga karena pasien sedang sakit","Mengkaji sumber ketakutan dan kebutuhan pasien, menjelaskan informasi, menghormati otonomi, serta mengoordinasikan diskusi tim sesuai urgensi klinis","Mengesampingkan dimensi spiritual karena tidak berkaitan dengan tindakan","Menerima penolakan tanpa mengevaluasi pemahaman atau risiko"],"answer":1,"explanation":"Asuhan holistik perlu menggali kebutuhan fisik, psikologis, sosial, spiritual, dan budaya. Penolakan ditangani dengan komunikasi dan penghormatan otonomi, sekaligus kolaborasi tim untuk menilai dampak klinis.","source":"Holistik, hlm. 17–23; Etik dan Legal, hlm. 23","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q079","domain":"S","kind":"app","tier":4,"question":"Puskesmas menangani pasien dengan kondisi khusus yang telah ditegakkan diagnosis dan rencana terapinya. Pelayanan berulang tersebut hanya tersedia di fasilitas tingkat tersier. Berdasarkan materi, tindakan rujukan yang tepat adalah ...","options":["Tidak boleh dilakukan karena semua pasien wajib melewati setiap tingkat tanpa pengecualian","Dapat dirujuk langsung ke fasilitas tersier dalam kekhususan yang disebutkan materi","Harus dirujuk horizontal ke puskesmas lain tanpa mempertimbangkan layanan","Dirujuk ke layanan primer lain karena tingkat tersier hanya untuk rawat inap"],"answer":1,"explanation":"Materi menyebut kekhususan rujukan dari fasilitas primer langsung ke tersier untuk kasus tertentu yang diagnosis dan rencana terapinya telah ditegakkan, bersifat berulang, dan hanya tersedia di fasilitas tersier.","source":"Sistem Pelayanan, hlm. 21","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q080","domain":"E","kind":"case","tier":4,"question":"Seorang perawat menyadari telah melakukan kesalahan pencatatan yang berpotensi memengaruhi keputusan tim. Ia mempertimbangkan untuk menghapus catatan lama agar tidak diketahui. Tindakan profesional yang paling tepat adalah ...","options":["Menghapus catatan agar tidak terjadi kebingungan","Mencatat koreksi sesuai prosedur, melaporkan secara jujur, dan memastikan tim menerima informasi yang benar","Menunggu sampai pasien pulang untuk menjelaskan","Semua jawaban benar"],"answer":1,"explanation":"Akuntabilitas menuntut transparansi, dokumentasi jujur, serta pelaporan segera agar dapat dilakukan tindakan korektif. Manipulasi catatan bertentangan dengan akuntabilitas.","source":"Etik dan Legal, hlm. 14–16","trap":true,"tierLabel":"Sintesis lanjutan"},{"id":"Q081","domain":"P","kind":"concept","tier":4,"question":"Pernyataan yang paling tepat membedakan standar praktik profesional dari standar kinerja profesional dalam materi adalah ...","options":["Standar praktik profesional menguraikan proses asuhan I–V, sedangkan standar kinerja profesional memuat mutu, pendidikan, penilaian kerja, kesejawatan, etik, kolaborasi, riset, dan sumber daya","Keduanya hanya berisi daftar tindakan medis yang harus dilakukan dokter","Standar kinerja profesional menggantikan seluruh proses keperawatan","Standar praktik hanya berlaku pada pelayanan rumah sakit"],"answer":0,"explanation":"Materi membagi lingkup standar menjadi lima standar praktik profesional (pengkajian sampai evaluasi) dan delapan standar kinerja profesional.","source":"Standar Praktik, hlm. 7–8, 17","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q082","domain":"I","kind":"app","tier":4,"question":"Sebuah tim memiliki komunikasi terbuka, tetapi sering terjadi tumpang tindih tugas. Sebelum membuat rencana baru, langkah yang paling sesuai dengan kompetensi CIHC adalah ...","options":["Meminta semua profesi menjalankan tindakan yang sama","Mengklarifikasi dan menegosiasikan peran serta tanggung jawab masing-masing","Menghentikan diskusi tim sampai konflik hilang","Menempatkan satu profesi untuk mengambil alih seluruh pekerjaan"],"answer":1,"explanation":"CIHC 2024 menempatkan klarifikasi dan negosiasi peran sebagai domain penting, didukung fungsi tim, komunikasi, kepemimpinan kolaboratif, dan relasi berpusat pada pasien.","source":"IPC, slide 10","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q083","domain":"S","kind":"case","tier":4,"question":"Seorang pasien memerlukan penanganan penyakit untuk penyembuhan, sedangkan puskesmas membutuhkan dukungan teknologi dan sarana dari fasilitas lain untuk meningkatkan derajat kesehatan masyarakat. Pembedaan jenis rujukan yang tepat adalah ...","options":["Keduanya rujukan medis","Kebutuhan penyembuhan adalah rujukan medis; dukungan teknologi/sarana untuk peningkatan kesehatan termasuk rujukan kesehatan","Keduanya rujukan horizontal","Penyembuhan adalah rujukan kesehatan dan dukungan teknologi adalah rujukan medis"],"answer":1,"explanation":"Materi membedakan rujukan medis yang berkaitan dengan upaya kedokteran untuk penyembuhan penyakit dan rujukan kesehatan yang berkaitan dengan pencegahan serta peningkatan derajat kesehatan, termasuk teknologi, sarana, dan operasional.","source":"Sistem Pelayanan, hlm. 14","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q084","domain":"P","kind":"case","tier":4,"question":"Seorang klien melaporkan sesak, data objektif menunjukkan perubahan tanda vital, dan keluarga menyampaikan perubahan pola aktivitas. Perawat merumuskan masalah, penyebab, dan tanda/gejala, lalu bekerja sama dengan klien untuk memvalidasi diagnosis. Urutan penalaran yang paling tepat adalah ...","options":["Menetapkan intervensi terlebih dahulu, kemudian mencari data pendukung","Menganalisis dan menginterpretasi data, mengidentifikasi masalah, merumuskan diagnosis, lalu memvalidasi","Mencatat diagnosis medis sebagai diagnosis keperawatan","Menunggu keputusan tim sebelum melakukan pengkajian"],"answer":1,"explanation":"Standar diagnosis menempatkan analisis dan interpretasi data sebelum identifikasi masalah dan perumusan diagnosis. Validasi serta kaji ulang dilakukan bersama klien dan tim bila relevan.","source":"Standar Praktik, hlm. 11–12","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q085","domain":"H","kind":"app","tier":4,"question":"Perawat mempertimbangkan pencegahan stresor sebelum muncul gejala, intervensi saat gejala mulai tampak, dan dukungan adaptasi setelah pengobatan. Pemetaan yang tepat menurut diagram Neuman adalah ...","options":["Primer setelah gejala, sekunder sebelum stresor, tersier saat diagnosis","Primer sebelum reaksi terhadap stresor, sekunder saat gejala muncul, tersier pada adaptasi dan pemulihan","Primer untuk rehabilitasi, sekunder untuk promosi kesehatan, tersier untuk diagnosis dini","Ketiganya merupakan tahap yang tidak berhubungan"],"answer":1,"explanation":"Diagram Neuman mengurutkan pencegahan primer sebelum reaksi terhadap stresor, sekunder saat gejala muncul, dan tersier sebagai adaptasi serta pemulihan setelah pengobatan.","source":"Holistik, hlm. 12","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q086","domain":"I","kind":"app","tier":4,"question":"Dalam tim, seorang perawat menerima delegasi tugas yang belum sesuai dengan kompetensinya. Ia juga mengetahui ada profesi lain yang memiliki kewenangan terkait. Keputusan yang paling sesuai dengan aspek etis-legal IPC adalah ...","options":["Menerima tugas untuk menjaga hubungan baik meskipun tidak kompeten","Mengklarifikasi batas kewenangan, menyampaikan keterbatasan, dan meminta konsultasi atau penugasan sesuai kompetensi","Menyerahkan seluruh tindakan kepada keluarga","Melakukan tugas tanpa dokumentasi agar proses cepat"],"answer":1,"explanation":"Prinsip IPC menuntut kerja dalam batas kewenangan dan kode etik. Kode etik praktik juga menekankan keputusan berdasarkan informasi akurat dan kemampuan/kualifikasi pihak yang menerima delegasi.","source":"IPC, slide 11; Etik dan Legal, hlm. 8","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q087","domain":"S","kind":"case","tier":4,"question":"Sistem rujukan dirancang agar pasien memperoleh layanan sedekat mungkin dengan tempat tinggalnya selama kebutuhan klinis dapat dipenuhi. Manfaat yang paling sesuai dengan materi adalah ...","options":["Mendorong seluruh kasus ditangani hanya di fasilitas primer","Pertolongan dapat lebih cepat, lebih murah, memberi rasa aman, dan meningkatkan kemampuan petugas daerah","Menghilangkan kebutuhan fasilitas rujukan","Memastikan semua kasus harus ditangani oleh dokter subspesialis"],"answer":1,"explanation":"Materi menyebut keuntungan layanan sedekat mungkin dengan pasien berupa pertolongan lebih cepat, murah, memberi rasa aman, dan peningkatan pengetahuan/keterampilan petugas setempat.","source":"Sistem Pelayanan, hlm. 15","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q088","domain":"P","kind":"standard","tier":4,"question":"Pengelola unit menyesuaikan distribusi alat dan tenaga berdasarkan beban kerja, memastikan alat berfungsi, menganalisis anggaran, dan tetap mempertimbangkan keamanan serta efektivitas layanan. Standar yang paling tepat adalah ...","options":["Pendidikan","Pemanfaatan sumber-sumber","Kesejawatan","Penilaian kerja individu"],"answer":1,"explanation":"Standar VIII mencakup pengelolaan dan pemanfaatan sumber daya secara efektif, tidak boros, serta mempertimbangkan keamanan, efektivitas, dan biaya.","source":"Standar Praktik, hlm. 35–37","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q089","domain":"E","kind":"case","tier":4,"question":"Seorang anggota keluarga meminta perawat mengirim foto rekam medis pasien ke grup keluarga. Pasien belum memberi izin dan tidak ada permintaan dari pihak berwenang. Perawat sebaiknya ...","options":["Mengirim foto karena keluarga pasti berhak mengetahui semua data","Menjaga kerahasiaan dan menjelaskan bahwa informasi hanya dapat dibagikan sesuai persetujuan atau ketentuan yang sah","Mengirim foto dengan menghapus nama pasien saja","Semua jawaban benar"],"answer":1,"explanation":"Kerahasiaan klien wajib dijaga. Materi menyebut pengecualian bila informasi diperlukan oleh pihak berwenang sesuai ketentuan hukum; permintaan keluarga saja tidak otomatis menjadi dasar pengungkapan.","source":"Etik dan Legal, hlm. 4, 7, 22","trap":true,"tierLabel":"Sintesis lanjutan"},{"id":"Q090","domain":"H","kind":"case","tier":4,"question":"Pasien ingin mencoba terapi komplementer yang disarankan keluarganya. Sebagian klaim belum memiliki dasar ilmiah yang jelas dan pasien masih membutuhkan terapi utama. Respons perawat yang paling sesuai dengan batasan legal-etik pada materi adalah ...","options":["Mendukung terapi sebagai pengganti seluruh terapi medis","Menjelaskan bahwa terapi komplementer hanya sebagai pelengkap, perlu kaidah ilmiah, keselamatan, kepentingan pasien, serta kesesuaian norma dan aturan fasilitas","Melarang seluruh terapi komplementer tanpa mengkaji jenis dan risikonya","Membiarkan pasien mencoba tanpa memberi informasi karena keputusan pribadi"],"answer":1,"explanation":"Materi menyatakan terapi komplementer harus menjadi pelengkap, bukan utama, serta memperhatikan kaidah ilmiah, nonmaleficence, kepentingan pasien, norma/budaya, dan hukum fasilitas kesehatan.","source":"Holistik, hlm. 24","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q091","domain":"I","kind":"case","tier":4,"question":"Dalam asuhan terintegrasi, DPJP memimpin dan memverifikasi rencana klinis, PPJA mengoordinasikan dan memberikan asuhan keperawatan, apoteker meninjau obat, dietisien mengatur terapi gizi, dan MPP mengawal kesinambungan. Jika pasien akan pulang, bentuk koordinasi yang paling tepat adalah ...","options":["Masing-masing profesi menyiapkan instruksi sendiri tanpa saling membaca","Menyusun discharge planning terintegrasi, mengedukasi pasien/keluarga, dan mendokumentasikan informasi pada CPPT","Menyerahkan seluruh proses pulang kepada MPP tanpa keterlibatan PPA","Menghentikan koordinasi setelah DPJP menandatangani rencana"],"answer":1,"explanation":"Discharge planning dilakukan sejak awal rawat dan perlu melibatkan PPA serta edukasi keluarga. CPPT mendukung kesinambungan informasi; MPP menjaga koordinasi, bukan menggantikan PPA.","source":"IPC, slide 7, 15–16","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q092","domain":"S","kind":"app","tier":4,"question":"Sebuah program masyarakat menggabungkan penyuluhan, perlindungan khusus, deteksi dini, pengobatan segera, serta pemulihan. Kesimpulan yang paling tepat adalah ...","options":["Sistem pelayanan kesehatan hanya mencakup pengobatan penyakit","Pelayanan kesehatan mencakup upaya memelihara, meningkatkan, mencegah, menyembuhkan, dan memulihkan kesehatan","Promosi kesehatan tidak termasuk pelayanan kesehatan","Pemulihan hanya dapat dilakukan di rumah sakit tersier"],"answer":1,"explanation":"Definisi pelayanan kesehatan dalam materi mencakup pemeliharaan dan peningkatan kesehatan, pencegahan, penyembuhan, serta pemulihan bagi individu, keluarga, kelompok, dan masyarakat.","source":"Sistem Pelayanan, hlm. 3, 7","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q093","domain":"P","kind":"case","tier":4,"question":"Perawat sudah melakukan edukasi, tetapi belum memeriksa pemahaman pasien dan keluarga. Saat evaluasi, pasien tidak mampu mengulang cara perawatan luka di rumah. Langkah perbaikan yang paling tepat adalah ...","options":["Mencatat edukasi telah selesai karena materi sudah disampaikan","Mengulang edukasi dengan cara yang sesuai, meminta pasien melakukan teach-back, lalu mendokumentasikan pemahaman dan rencana dukungan rumah","Menganggap pasien tidak patuh dan menghentikan edukasi","Meminta keluarga bertanggung jawab tanpa menilai kesiapan"],"answer":1,"explanation":"Asuhan holistik dan kesinambungan pulang menekankan verifikasi pemahaman/kemandirian klien. Diagram transisi menampilkan teach-back, dukungan keluarga, dan pengenalan tanda bahaya.","source":"Holistik, hlm. 25; IPC, slide 15","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q094","domain":"I","kind":"app","tier":4,"question":"Sebuah tim menerapkan SBAR, TBaK, huddle, briefing, CPPT, serta pembagian peran yang jelas. Tujuan utama gabungan strategi tersebut adalah ...","options":["Memperbanyak dokumentasi tanpa mengubah keselamatan","Mengurangi kegagalan komunikasi, memperjelas koordinasi, dan mendukung keselamatan serta mutu asuhan","Menggantikan seluruh penilaian klinis profesi","Membuat keputusan klinis hanya berdasarkan instruksi lisan"],"answer":1,"explanation":"Materi menyebut komunikasi terstruktur dan dokumentasi terintegrasi sebagai strategi memperkuat IPC, mencegah kesalahan, dan menjaga keselamatan pasien.","source":"IPC, slide 13–15","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q095","domain":"P","kind":"standard","tier":4,"question":"Perawat mengidentifikasi masalah klien, menetapkan tujuan, melaksanakan tindakan, dan menilai hasilnya. Pada saat yang sama ia mengikuti kegiatan jaminan mutu dan pendidikan berkelanjutan. Pernyataan yang paling tepat adalah ...","options":["Proses keperawatan dan standar kinerja profesional saling melengkapi dalam menjaga mutu asuhan","Pendidikan berkelanjutan menggantikan kebutuhan evaluasi pasien","Jaminan mutu hanya tugas manajer dan tidak terkait praktik klinis","Evaluasi hasil tidak diperlukan bila standar telah ditetapkan"],"answer":0,"explanation":"Lima standar praktik profesional mengatur proses asuhan, sedangkan delapan standar kinerja mendukung mutu dan profesionalisme. Keduanya saling melengkapi.","source":"Standar Praktik, hlm. 8–22","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q096","domain":"S","kind":"case","tier":4,"question":"Sebuah fasilitas memiliki tenaga terlatih dan alat memadai, tetapi pembiayaan tidak efektif dan informasi pasien sering tidak dapat dipercaya. Berdasarkan komponen sistem kesehatan dalam materi, analisis yang paling tepat adalah ...","options":["Sistem sudah berfungsi baik karena tenaga dan alat tersedia","Dua komponen penting, pembiayaan efektif dan informasi andal, masih menjadi kelemahan sistem","Masalah hanya terkait perilaku pasien","Sistem informasi tidak termasuk komponen pelayanan kesehatan"],"answer":1,"explanation":"Materi menyebut sistem berfungsi baik jika memiliki mekanisme pembiayaan efektif, tenaga terlatih, informasi andal, serta fasilitas memadai. Keempatnya perlu berjalan bersama.","source":"Sistem Pelayanan, hlm. 3–4","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q097","domain":"E","kind":"app","tier":4,"question":"Perawat menghadapi konflik antara keinginan pasien, rekomendasi klinis, dan keterbatasan sumber daya. Ia mengidentifikasi masalah, menilai prinsip yang relevan, melibatkan tim multidisiplin, lalu mengevaluasi dampak keputusan. Proses tersebut menunjukkan ...","options":["Keputusan legal-etik yang sistematis","Delegasi tindakan tanpa pertimbangan","Pengalihan seluruh tanggung jawab kepada pasien","Penggunaan prinsip keadilan saja tanpa analisis"],"answer":0,"explanation":"Materi pengambilan keputusan legal-etik memuat empat langkah: identifikasi masalah, analisis prinsip etik, melibatkan tim multidisiplin, dan evaluasi dampak keputusan.","source":"Etik dan Legal, hlm. 23","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q098","domain":"H","kind":"case","tier":4,"question":"Seorang pasien menunjukkan kecemasan dan gangguan tidur. Perawat memperbaiki pencahayaan dan ventilasi, mengurangi kebisingan, menyediakan kesempatan berbicara, mengikutsertakan keluarga, serta menanyakan kebutuhan spiritual pasien. Kesimpulan yang paling tepat adalah ...","options":["Intervensi mencampuradukkan tugas sehingga tidak termasuk asuhan holistik","Intervensi menggabungkan perspektif lingkungan, psikososial, caring, dan kebutuhan spiritual dalam satu asuhan berpusat pada pasien","Intervensi hanya sesuai bila pasien tidak memiliki diagnosis medis","Perawat seharusnya memilih satu teori dan mengabaikan yang lain"],"answer":1,"explanation":"Materi menggambarkan integrasi teori: Nightingale (lingkungan), Neuman (stresor), Roy (adaptasi), Watson (caring), dan Leininger (budaya) dalam satu proses asuhan berpusat pada pasien.","source":"Holistik, hlm. 18–19","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q099","domain":"P","kind":"app","tier":4,"question":"Setelah implementasi, perawat menemukan bahwa nyeri klien menurun, tetapi klien masih kesulitan tidur dan belum mencapai tujuan aktivitas. Respons evaluasi yang paling tepat adalah ...","options":["Menutup asuhan karena satu indikator sudah membaik","Menganalisis respons secara menyeluruh bersama klien, menilai tujuan yang belum tercapai, dan menyesuaikan rencana tindakan","Mengulang semua intervensi awal tanpa mengkaji penyebab hambatan","Mempertahankan rencana karena perubahan akan mengganggu konsistensi dokumentasi"],"answer":1,"explanation":"Evaluasi membandingkan respons klien dengan tujuan, menggunakan data terbaru, melibatkan klien/keluarga, lalu merevisi data, diagnosis, atau rencana bila diperlukan. Perbaikan sebagian tidak otomatis berarti seluruh tujuan tercapai.","source":"Standar Praktik, hlm. 15–16","trap":false,"tierLabel":"Sintesis lanjutan"},{"id":"Q100","domain":"P","kind":"standard","tier":4,"question":"Dalam penerapan standar kolaborasi profesional, seorang perawat berkonsultasi dengan profesi lain sesuai kebutuhan, mengomunikasikan pengetahuan keperawatan, melibatkan klien dalam tim multidisiplin, dan menghargai kontribusi sejawat. Penilaian yang paling tepat adalah ...","options":["Perawat menjalankan Standar VI Kolaborasi dengan tetap berperan sebagai advokat klien","Perawat menyerahkan tanggung jawab asuhan sepenuhnya kepada profesi lain","Perawat melaksanakan kolaborasi hanya bila diminta DPJP","Perawat membatasi komunikasi agar setiap profesi tetap bekerja mandiri"],"answer":0,"explanation":"Standar VI Kolaborasi mencakup konsultasi profesi lain, komunikasi pengetahuan dan keterampilan, keterlibatan klien dalam tim multidisiplin, advokasi, dan penghormatan terhadap kontribusi sejawat.","source":"Standar Praktik, hlm. 30","trap":false,"tierLabel":"Sintesis lanjutan"}];
const domainNames={H:'Keperawatan Holistik',E:'Etik dan Legal',I:'Kolaborasi Interprofesi (IPC)',S:'Sistem Pelayanan Kesehatan',P:'Standar Praktik Keperawatan'};
const kindNames={case:'Studi kasus',app:'Penerapan',concept:'Konsep / integrasi',standard:'Standar praktik'};
const domainTargets={H:20/110*100,E:10/110*100,I:30/110*100,S:20/110*100,P:30/110*100};
const kindTargets={case:30,app:40,concept:10,standard:20};
let ordered=[],answers={},submitted=false,weights={};
function shuffle(a){const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]];}return b;}
function buildWeights(){
 // Iterative proportional fitting: each material and each model receives its requested share of 100 points.
 const domains=['H','E','I','S','P'],kinds=['case','app','concept','standard'];
 const m={}; domains.forEach(d=>{m[d]={};kinds.forEach(k=>m[d][k]=BANK.filter(q=>q.domain===d&&q.kind===k).length);});
 let v={};domains.forEach(d=>{v[d]={};kinds.forEach(k=>v[d][k]=m[d][k] ? m[d][k] : 0);});
 for(let iter=0;iter<3000;iter++){
   domains.forEach(d=>{let s=kinds.reduce((a,k)=>a+v[d][k],0);let f=domainTargets[d]/s;kinds.forEach(k=>{if(m[d][k])v[d][k]*=f;});});
   kinds.forEach(k=>{let s=domains.reduce((a,d)=>a+v[d][k],0);let f=kindTargets[k]/s;domains.forEach(d=>{if(m[d][k])v[d][k]*=f;});});
 }
 const per={};BANK.forEach(q=>{per[q.id]=v[q.domain][q.kind]/m[q.domain][q.kind];});return per;
}
function orderBank(){
 const groups=[1,2,3,4].map(t=>shuffle(BANK.filter(q=>q.tier===t)));
 ordered=groups.flat().map((q,i)=>({...q,displayNo:i+1,shuffledOptions:shuffle(q.options.map((text,index)=>({text,isCorrect:index===q.answer})))}));
 answers={};submitted=false;document.getElementById('resultSection').style.display='none';document.getElementById('quizSection').style.display='block';
 document.getElementById('warning').textContent='';renderQuestions();updateProgress();
 document.getElementById('submitBtn').disabled=true;
}
function renderQuestions(){
 const root=document.getElementById('questions');root.innerHTML='';
 let lastTier=0;
 ordered.forEach((q,idx)=>{
  if(q.tier!==lastTier){lastTier=q.tier;const h=document.createElement('div');h.style.cssText='padding:18px 2px 8px;color:#16834b;font-weight:800;font-size:14px';h.textContent=`Tahap ${q.tier} · ${q.tierLabel}`;root.appendChild(h);}
  const el=document.createElement('article');el.className='qcard';el.id='card-'+q.id;
  const head=document.createElement('div');head.className='qhead';head.innerHTML=`<span class="num">${idx+1}</span><span>PERTANYAAN</span><span class="tier">${q.tierLabel}</span>`;
  const p=document.createElement('p');p.className='qtext';p.textContent=q.question;
  const opts=document.createElement('div');opts.className='opts';
  q.shuffledOptions.forEach((o,j)=>{
   const label=document.createElement('label');label.className='opt';label.dataset.question=q.id;
   const input=document.createElement('input');input.type='radio';input.name=q.id;input.value=String(j);input.addEventListener('change',()=>{answers[q.id]=j;opts.querySelectorAll('.opt').forEach(x=>x.classList.remove('selected'));label.classList.add('selected');updateProgress();});
   const span=document.createElement('span');span.textContent=String.fromCharCode(65+j)+'. '+o.text;label.append(input,span);opts.appendChild(label);
  });
  el.append(head,p,opts);root.appendChild(el);
 });
}
function updateProgress(){
 const n=Object.keys(answers).length;document.getElementById('progressText').textContent=`${n} / 100 terjawab`;document.getElementById('progressBar').style.width=(n)+'%';document.getElementById('submitBtn').disabled=n!==100||submitted;
}
function evaluate(){
 if(submitted)return;
 if(Object.keys(answers).length!==100){document.getElementById('warning').textContent=`Masih ada ${100-Object.keys(answers).length} soal yang belum dijawab.`;return;}
 submitted=true;let points=0,correct=0;const topic={},kind={};
 Object.keys(domainNames).forEach(d=>topic[d]={total:0,correct:0,score:0,max:domainTargets[d]});
 Object.keys(kindNames).forEach(k=>kind[k]={total:0,correct:0,score:0,max:kindTargets[k]});
 ordered.forEach(q=>{
  const chosen=q.shuffledOptions[answers[q.id]],ok=chosen.isCorrect,w=weights[q.id];
  topic[q.domain].total++;kind[q.kind].total++;
  if(ok){correct++;points+=w;topic[q.domain].correct++;topic[q.domain].score+=w;kind[q.kind].correct++;kind[q.kind].score+=w;}
 });
 const score=Math.round(points*100)/100;document.getElementById('scoreBig').textContent=score.toFixed(2).replace('.',',');
 document.getElementById('correctCount').textContent=correct;document.getElementById('wrongCount').textContent=100-correct;document.getElementById('answeredCount').textContent='100';
 let msg=score>=85?'Sangat baik. Pertahankan kemampuan analisis dan konsistensi penerapan.':score>=75?'Baik. Tinjau kembali butir yang keliru untuk memperkuat penerapan konsep.':score>=60?'Cukup. Fokuskan belajar pada topik dengan capaian terendah.':'Perlu penguatan. Baca kembali materi dan pelajari pembahasan tiap soal.';
 document.getElementById('resultMessage').textContent=msg;
 document.getElementById('topicRows').innerHTML=Object.keys(domainNames).map(d=>`<tr><td>${domainNames[d]}</td><td class="right">${topic[d].correct}/${topic[d].total}</td><td class="right">${topic[d].score.toFixed(2)} / ${topic[d].max.toFixed(2)}</td></tr>`).join('')+`<tr><th>Total</th><th class="right">${correct}/100</th><th class="right">${score.toFixed(2)} / 100</th></tr>`;
 document.getElementById('kindRows').innerHTML=Object.keys(kindNames).map(k=>`<tr><td>${kindNames[k]}</td><td class="right">${kind[k].correct}/${kind[k].total}</td><td class="right">${kind[k].score.toFixed(2)} / ${kind[k].max.toFixed(2)}</td></tr>`).join('')+`<tr><th>Total</th><th class="right">${correct}/100</th><th class="right">${score.toFixed(2)} / 100</th></tr>`;
 renderReview();document.getElementById('quizSection').style.display='none';document.getElementById('progressCard').style.display='none';document.getElementById('resultSection').style.display='block';window.scrollTo({top:0,behavior:'smooth'});
}
function renderReview(){
 const root=document.getElementById('review');root.innerHTML='';
 ordered.forEach((q,idx)=>{
  const chosenIndex=answers[q.id],chosen=q.shuffledOptions[chosenIndex],correctOption=q.shuffledOptions.find(o=>o.isCorrect),ok=chosen.isCorrect;
  const d=document.createElement('details');d.className='review-item';if(!ok)d.open=false;
  const summary=document.createElement('summary');summary.innerHTML=`${idx+1}. ${escapeHtml(q.question.slice(0,105))}${q.question.length>105?'…':''} <span class="status ${ok?'ok':'no'}">${ok?'Benar':'Belum tepat'}</span> ${q.trap?'<span class="status trapbadge">Soal jebakan</span>':''}`;
  const body=document.createElement('div');body.className='review-body';
  const choices=q.shuffledOptions.map((o,j)=>{let cls='opt disabled';if(o.isCorrect)cls+=' correct';else if(j===chosenIndex&&!ok)cls+=' incorrect';return `<div class="${cls}"><span>${String.fromCharCode(65+j)}. ${escapeHtml(o.text)}${o.isCorrect?' <b>← Kunci</b>':''}${j===chosenIndex?' <b>← Jawaban Anda</b>':''}</span></div>`;}).join('');
  body.innerHTML=`<div style="display:grid;gap:7px">${choices}</div><div class="review-explain"><b>Pembahasan:</b> ${escapeHtml(q.explanation)}</div><div class="source">Materi: ${escapeHtml(domainNames[q.domain])} · ${escapeHtml(q.source)} · Poin butir: ${weights[q.id].toFixed(3)}</div>`;
  d.append(summary,body);root.appendChild(d);
 });
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
document.getElementById('submitBtn').addEventListener('click',evaluate);
document.getElementById('shuffleBtn').addEventListener('click',()=>{if(submitted)return;if(!confirm('Urutan soal dan opsi akan diacak ulang. Jawaban yang sudah diisi akan dihapus. Lanjutkan?'))return;orderBank();window.scrollTo({top:0,behavior:'smooth'});});
document.getElementById('restartBtn').addEventListener('click',()=>{document.getElementById('progressCard').style.display='block';orderBank();window.scrollTo({top:0,behavior:'smooth'});});
weights=buildWeights();orderBank();
</script>
</body></html>
